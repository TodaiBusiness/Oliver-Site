# =============================================================================
# Modelo de variáveis de ambiente — COPIE para `.env` e preencha.
# O `.env` está no .gitignore e NUNCA deve ir para o Git/GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONT-END (prefixo VITE_)
# -----------------------------------------------------------------------------
# ⚠️ ATENÇÃO: tudo que começa com VITE_ é embutido no JavaScript enviado ao
# navegador. É PÚBLICO. Nunca coloque senha, chave de API ou credencial de
# banco aqui — qualquer visitante consegue ler.
# -----------------------------------------------------------------------------

# E-mail de contato exibido no site.
VITE_COMPANY_EMAIL=contato@seudominio.com.br

# Endereço público do site, usado em canonical e Open Graph (index.html).
# Lido no BUILD: mudar exige um novo deploy para valer. Sem barra final.
# Em branco, cai na URL .onrender.com definida em vite.config.js.
VITE_SITE_URL=https://oliver-imports-site.onrender.com

# Link do instalador do sistema (página /baixar). Público: vai para o navegador.
# Lido no BUILD. Em branco, a página explica que o link chega por e-mail.
VITE_INSTALLER_URL=


# =============================================================================
# BACK-END — nada aqui leva o prefixo VITE_, de propósito.
# Estas variáveis só existem no servidor (o processo Node do server.js).
# No Render: serviço → Environment → Environment Variables
# =============================================================================

# Qual banco usar: "sqlite" (desenvolvimento) ou "postgres" (produção/Neon).
DATABASE_DRIVER=sqlite

# Caminho do arquivo SQLite (só usado quando DATABASE_DRIVER=sqlite).
SQLITE_FILE=server/data/oliver.db

# --- PostgreSQL / Neon (produção) --------------------------------------------
# URI completa que o Neon mostra em "Connection string". Use a versão POOLED
# (o host tem "-pooler" no meio) — ela aguenta várias instâncias sem estourar
# o limite de conexões.
#
# Formato:
#   postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/oliver_site
#
# Esta variável contém a SENHA do banco. Ela nunca vai para o Git nem para o
# navegador: só existe no painel do serviço que roda a API.
DATABASE_URL=

# TLS. Deixe vazio ou "require" (padrão) em qualquer banco hospedado.
# Só use "disable" para um PostgreSQL rodando na sua própria máquina.
DATABASE_SSL=require

# --- Sessões -----------------------------------------------------------------
# Reservado e opcional: hoje nada o usa (a sessão é um token aleatório cujo hash
# fica no banco). Pode ficar em branco. Se quiser preencher, gere um valor longo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Origens autorizadas (proteção de CSRF) ----------------------------------
# Domínios que podem enviar POST/PUT/PATCH/DELETE. Separe por vírgula, sem
# barra final. Apex e www são origens diferentes para o navegador: liste as
# duas se o site responder nos dois nomes.
#
# No Render pode ficar vazia: o servidor cai no RENDER_EXTERNAL_URL (o endereço
# .onrender.com do serviço). Fora do Render, com NODE_ENV=production, o
# servidor se recusa a subir sem esta variável — de propósito, porque vazio
# significaria nenhuma conferência de Origin em rota nenhuma.
ALLOWED_ORIGINS=https://oliver-imports-site.onrender.com

# --- Endereço público do site ------------------------------------------------
# Usado na compra: o Mercado Pago leva o cliente de volta para
# SITE_PUBLIC_URL/obrigado depois de pagar. Precisa ser https e sem barra final.
# Sem esta variável, "Comprar" responde "indisponível" em vez de mandar o
# cliente pagar sem ter para onde voltar.
SITE_PUBLIC_URL=https://seudominio.com.br

# --- Oliver Licensing (API central) ------------------------------------------
# Os orçamentos pedidos no site NÃO ficam no banco daqui: são gravados na API
# de licenciamento, que é onde o Panel Desktop os lê. Sem estas duas variáveis
# o formulário responde "indisponível" em vez de perder o pedido em silêncio.
#
# As duas andam juntas: preencher só uma derruba o servidor no start, de
# propósito — integração pela metade falharia só na frente do visitante.
#
# Endereço da API, sem caminho. Com ou sem barra final, tanto faz.
LICENSING_API_BASE_URL=

# Credencial de serviço. É a MESMA string configurada como SITE_SERVICE_API_KEY
# na API de licenciamento — as duas pontas comparam o mesmo valor. Mínimo de 32
# caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Não é sessão de administrador e não abre o painel: dá acesso apenas a criar
# solicitação de orçamento. Nunca leva prefixo VITE_.
SITE_SERVICE_API_KEY=

# Tempo máximo de espera, em milissegundos. O padrão de 90s cobre o cold start
# do plano gratuito do Render, que hiberna após 15 minutos parado.
LICENSING_API_TIMEOUT_MS=90000

# --- Visitas do site (relatório para o Panel Desktop) -------------------------
# Chave que a API de licenciamento envia no cabeçalho X-Analytics-Key para ler
# GET /api/analytics/report. É a MESMA string de SiteAnalytics__ReadKey na API.
# Mínimo de 32 caracteres; sem ela (ou curta demais) a rota responde 503 e o site
# continua contando visitas normalmente. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca leva prefixo VITE_. País e cidade só aparecem se o proxy/CDN enviar
# CF-IPCountry/CF-IPCity (ou equivalentes); senão ficam "Desconhecido".
ANALYTICS_READ_KEY=

# --- Administrador inicial ---------------------------------------------------
# Usados SÓ pelo script `npm run db:seed-admin`.
# A senha é convertida em hash (scrypt) antes de tocar no banco e nunca é
# gravada em texto puro. Troque-a após o primeiro acesso.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
